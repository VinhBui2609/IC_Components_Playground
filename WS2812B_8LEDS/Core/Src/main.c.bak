  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_TIM1_Init();
  /* USER CODE BEGIN 2 */

  Set_LED(0, 255, 0, 0);
  Set_LED(1, 0, 255, 0);
  Set_LED(2, 0, 0, 255);
  Set_LED(3, 0, 0, 0);
  Set_LED(4, 0, 0, 0);
  Set_LED(5, 0, 0, 0);
  Set_LED(6, 0, 0, 0);
  Set_LED(7, 0, 0, 0);

  WS2812_Send();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {


